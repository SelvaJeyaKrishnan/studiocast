# StudioCast Environment Variables Example
# Duplicate this file to .env.local and fill in your actual Supabase credentials.

# Public Variables (Accessible in browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Optional: Custom Canonical Site URL (Defaults to window.location.origin / VERCEL_URL if not provided)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Server-only Secret Key (Never expose to browser or prefix with NEXT_PUBLIC_)
# Only required if performing server-side administrative operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
